{
    "name": "rust-books",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "start": "node src/main.ts",
        "ebooks": "node src/generate-ebooks.ts",
        "ebooks:workers": "node scripts/build-ebooks-workers.ts",
        "ebooks:validate": "node scripts/validate-ebooks.ts",
        "ebooks:cache": "node scripts/finalize-ebook-cache.ts",
        "ebooks:verify-release": "node scripts/verify-release-cache.ts",
        "test:cache": "node --test scripts/ebook-cache.test.ts",
        "review:ebooks": "node scripts/review-epub-style.mjs",
        "generate-site": "node src/generate-site.ts",
        "lint": "oxlint",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "tsc --noEmit",
        "knip": "knip",
        "prepare": "simple-git-hooks"
    },
    "dependencies": {
        "p-limit": "^7.3.3",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.63.0",
        "toml": "^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "knip": "^6.38.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "simple-git-hooks": "^2.14.0",
        "typescript": "^7.0.2"
    },
    "simple-git-hooks": {
        "pre-commit": "bun run lint && bun run format && bun run knip && node src/generate-site.ts && git add docs/index.html"
    },
    "engines": {
        "node": ">=26"
    },
    "packageManager": "bun@1.4.2"
}
